---
import type { Locale } from '../../i18n/config';
import { t } from '../../i18n/utils';

interface Props { locale: Locale }
const { locale } = Astro.props;

const check = '<svg viewBox="0 0 10 10"><polyline points="2,5 4.5,7.5 8.5,2.5"/></svg>';
---

<section class="sec" id="pricing">
  <div class="sec-in">
    <div class="reveal" style="text-align:center">
      <div class="ey" style="justify-content:center">{t(locale, 'pr.ey')}</div>
      <h2 class="sttl" style="text-align:center" set:html={t(locale, 'pr.h')} />
      <p class="ssub" style="margin:0 auto;text-align:center">{t(locale, 'pr.sub')}</p>
    </div>
    <div class="pgrid">
      <!-- Free -->
      <div class="plan reveal">
        <div class="pname">{t(locale, 'pr.p1n')}</div>
        <div class="pprice"><div class="pv">$0</div></div>
        <div class="pnote">{t(locale, 'pr.p1note')}</div>
        <div class="pdiv"></div>
        <div class="pfs">
          {['pr.p1f1','pr.p1f2','pr.p1f3'].map(k => (
            <div class="pf"><div class="pfok" set:html={check} /><span>{t(locale, k)}</span></div>
          ))}
          {['pr.p1f4','pr.p1f5'].map(k => (
            <div class="pf dm"><div class="pfok" set:html={check} /><span>{t(locale, k)}</span></div>
          ))}
        </div>
        <a class="pbtn" href="#">{t(locale, 'pr.p1btn')}</a>
      </div>

      <!-- Academic (Popular) -->
      <div class="plan pop reveal" style="transition-delay:.1s">
        <div class="ptop">{t(locale, 'pr.pop')}</div>
        <div class="pname">{t(locale, 'pr.p2n')}</div>
        <div class="pprice"><div class="pv">$15</div><div class="pp">/ay</div></div>
        <div class="pnote">{t(locale, 'pr.p2note')}</div>
        <div class="pdiv"></div>
        <div class="pfs">
          {['pr.p2f1','pr.p2f2','pr.p2f3','pr.p2f4','pr.p2f5'].map(k => (
            <div class="pf"><div class="pfok" set:html={check} /><span>{t(locale, k)}</span></div>
          ))}
        </div>
        <a class="pbtn main" href="#" set:html={t(locale, 'pr.p2btn')} />
      </div>

      <!-- Pro -->
      <div class="plan reveal" style="transition-delay:.2s">
        <div class="pname">Pro</div>
        <div class="pprice"><div class="pv">$35</div><div class="pp">/ay</div></div>
        <div class="pnote">{t(locale, 'pr.p3note')}</div>
        <div class="pdiv"></div>
        <div class="pfs">
          {['pr.p3f1','pr.p3f2','pr.p3f3','pr.p3f4','pr.p3f5'].map(k => (
            <div class="pf"><div class="pfok" set:html={check} /><span>{t(locale, k)}</span></div>
          ))}
        </div>
        <a class="pbtn" href="#">{t(locale, 'pr.p3btn')}</a>
      </div>

      <!-- Enterprise -->
      <div class="plan reveal" style="transition-delay:.3s;border-color:var(--a2)">
        <div class="pname" style="color:var(--a)">{t(locale, 'pr.p4n')}</div>
        <div class="pprice"><div class="pv" style="font-size:22px;line-height:1.3;color:var(--a)" set:html={t(locale, 'pr.p4price')} /></div>
        <div class="pnote">{t(locale, 'pr.p4note')}</div>
        <div class="pdiv"></div>
        <div class="pfs">
          {['pr.p4f1','pr.p4f2','pr.p4f3','pr.p4f4'].map(k => (
            <div class="pf"><div class="pfok" set:html={check} /><span>{t(locale, k)}</span></div>
          ))}
        </div>
        <a class="pbtn am" href="#">{t(locale, 'pr.p4btn')}</a>
      </div>
    </div>
    <div class="pnote-b reveal">
      {['pr.tr1','pr.tr2','pr.tr3','pr.tr4'].map(k => (
        <span>{t(locale, k)}</span>
      ))}
    </div>
  </div>
</section>
