---
import '../styles/global.css';
import type { Locale } from '../i18n/config';
import { getAlternateLocale } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  locale: Locale;
}

const { title, description, locale } = Astro.props;
const altLocale = getAlternateLocale(locale);
---

<!DOCTYPE html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />

  <!-- i18n hreflang -->
  <link rel="alternate" hreflang="tr" href="https://presubly.com/tr/" />
  <link rel="alternate" hreflang="en" href="https://presubly.com/en/" />
  <link rel="alternate" hreflang="x-default" href="https://presubly.com/tr/" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Turnstile -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>

  <!-- Preconnect -->
  <link rel="dns-prefetch" href="https://api.anthropic.com" />
  <link rel="dns-prefetch" href="https://kmfwjvicfatfvrurolwn.supabase.co" />
</head>
<body>
  <slot />
</body>
</html>
