# Presubly — client env (Vite). Copy to .env and fill in.
# Only Supabase's PUBLIC values live here (safe to expose in the browser bundle).
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon-public-key...

# Cloudflare Turnstile site key (public). Boş bırakılırsa bot koruması pasif.
# Secret key koda konmaz — Supabase → Auth → Attack Protection → CAPTCHA'ya girilir.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxx
